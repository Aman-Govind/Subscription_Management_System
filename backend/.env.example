# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy this to .env and fill in your real values.
# The actual .env file is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Subscription Management API
APP_VERSION=1.0.0
DEBUG=False

# ── CORS — React frontend origin(s), comma-separated ─────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subscription_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
